---
import { site } from '../data/site';
import PhoneCta from './PhoneCta.astro';
import Icon from './Icon.astro';
---
<section id="contact" class="contact section" aria-labelledby="contact-title"><div class="container contact__inner"><p class="eyebrow">WE’RE HERE TO HELP</p><h2 id="contact-title">「これ、どうしよう？」と<br />思ったら。</h2><p>品物ひとつから、お片付けのお悩みまで。<br />まずはお気軽にお話をお聞かせください。</p><PhoneCta variant="light" label="悩んだら、まずお電話ください！" />{site.lineUrl && <a class="contact__line" href={site.lineUrl} target="_blank" rel="noopener noreferrer">LINEで相談する<Icon name="arrow" size={18} /></a>}<span class="contact__decoration contact__decoration--left" aria-hidden="true"><Icon name="leaf" size={180} /></span><span class="contact__decoration contact__decoration--right" aria-hidden="true"><Icon name="leaf" size={240} /></span></div></section>
<section id="company" class="company section" aria-labelledby="company-title"><div class="container company__inner"><div><p class="eyebrow">ABOUT US</p><h2 id="company-title">まごころを込めて、<br />丁寧に。</h2><p class="company__intro">お客様のお困りごとに寄り添い、<br />これまで培ってきた経験と<br />信頼関係を大切にしてまいります。</p></div><div><dl class="company-table"><div><dt>サービス名</dt><dd>{site.name}</dd></div><div><dt>運営会社</dt><dd>{site.company}</dd></div><div><dt>代表者</dt><dd>{site.representative}<small>（{site.representativeKana}）</small></dd></div><div><dt>所在地</dt><dd>〒{site.postcode}<br />{site.address}</dd></div><div><dt>電話番号</dt><dd><a href={site.phoneHref}>{site.phone}</a></dd></div><div><dt>営業時間・<br class="mobile-only" />電話対応時間</dt><dd>{site.hours}</dd></div><div><dt>対応エリア</dt><dd>{site.area}</dd></div>{site.permit && <div><dt>古物商許可</dt><dd>{site.permit.authority}<br />{site.permit.number}</dd></div>}</dl><p class="company__compliance">{site.compliance}</p></div></div></section>
